# ==============================
# Terraform files
# ==============================

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate
terraform.tfstate.backup

# Crash logs
crash.log
crash.*.log

# Terraform plan files
*.tfplan
*.plan

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# ==============================
# Terraform variable files
# ==============================

# Sensitive variable files
*.tfvars
*.tfvars.json

# Keep example variable files
!terraform.tfvars.example


# ==============================
# Terraform lock file
# ==============================

# Usually KEEP this file in Git
# Uncomment if you don't want to track it
# .terraform.lock.hcl


# ==============================
# AWS Credentials
# ==============================

.aws/
credentials
*.pem
*.key


# ==============================
# Environment files
# ==============================

.env
.env.*
*.env


# ==============================
# IDE files
# ==============================

# VS Code
.vscode/

# IntelliJ / Terraform plugin
.idea/


# ==============================
# Operating system files
# ==============================

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini


# ==============================
# Logs
# ==============================

*.log


# ==============================
# Temporary files
# ==============================

*.tmp
*.temp
*.bak